{
  "manifest_version": 3,
  "name": "Toolbox",
  "version": "1.0.0",
  "description": "11 essential browser tools in one place.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Toolbox"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
 "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
  "content/highlighter.js",
  "content/sticky-notes.js",
  "content/colorpicker.js",
  "content/reader-mode.js",
  "content/ruler.js"
],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}